{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@formspec-org/surface-react": [
        "vendor/formspec-surface-react/dist/index.d.ts"
      ],
      "@formspec-org/surface-react/widget-metadata": [
        "vendor/formspec-surface-react/dist/widget-metadata.d.ts"
      ],
      "@formspec-org/surface-react/widgets": [
        "vendor/formspec-surface-react/dist/widgets/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "formspec.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
