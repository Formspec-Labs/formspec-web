    {
      "name": "x-weekly-cert-able-and-available",
      "category": "concept",
      "version": "1.0.0",
      "status": "draft",
      "description": "Whether, for the certification week, the claimant was able to work and available to accept full-time work — \"Yes\" when ready to start work but not yet offered a job; \"No\" when something (health, hospitalization, transportation, childcare, caregiving, travel, a schedule conflict) prevented accepting a full-time job.",
      "compatibility": {
        "formspecVersion": "^1.0.0"
      },
      "conceptUri": "https://formspec-labs.github.io/formspec-demo/vocab/weekly-certification#able-and-available",
      "conceptSystem": "https://formspec-labs.github.io/formspec-demo/vocab/weekly-certification",
      "conceptCode": "able-and-available",
      "metadata": {
        "displayName": "Able and available for work",
        "sources": [
          {
            "title": "20 CFR 604.3 — able and available requirement",
            "uri": "https://www.law.cornell.edu/cfr/text/20/604.3"
          }
        ]
      },
      "equivalents": [
        {
          "concept": "https://www.law.cornell.edu/cfr/text/20/604.3",
          "system": "https://www.law.cornell.edu/cfr/text",
          "code": "20 CFR 604.3",
          "display": "Able and available requirement",
          "type": "exact"
        }
      ]
    },
