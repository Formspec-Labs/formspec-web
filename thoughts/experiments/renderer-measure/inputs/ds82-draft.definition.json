{
  "$formspec": "1.0",
  "url": "urn:experiment:ds82-subset",
  "version": "0.0.1",
  "status": "draft",
  "title": "DS-82 constructed renderer probe",
  "items": [
    {
      "key": "fullName",
      "type": "field",
      "dataType": "string",
      "label": "Full name"
    },
    {
      "key": "citizen",
      "type": "field",
      "dataType": "choice",
      "label": "Are you a United States citizen?",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "presentation": {
        "widget": "RadioGroup"
      }
    },
    {
      "key": "photo",
      "type": "field",
      "dataType": "attachment",
      "label": "Passport photo",
      "presentation": {
        "widget": "FileUpload",
        "accept": "image/jpeg,image/png",
        "maxSize": 5000000
      }
    },
    {
      "key": "affirmation",
      "type": "field",
      "dataType": "boolean",
      "label": "I affirm these answers are accurate"
    }
  ],
  "binds": [
    {
      "path": "fullName",
      "required": "true"
    },
    {
      "path": "citizen",
      "required": "true"
    },
    {
      "path": "photo",
      "required": "true"
    },
    {
      "path": "affirmation",
      "required": "true"
    }
  ]
}
