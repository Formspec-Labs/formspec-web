{
  "$formspec": "1.0",
  "url": "https://demo.formspec.org/ui/weekly-certification",
  "version": "2.0.0",
  "status": "active",
  "name": "weekly-certification",
  "title": "Weekly Benefits Certification",
  "issuer": {
    "url": "issuer/unemployment.issuer.json"
  },
  "description": "The form itself: what is asked, in what order, under what conditions, and what counts as a valid answer — nothing about how it looks (form-v2.theme.json) or the words in other languages (the Locale documents). How to read it: `items` is the question tree — two sections, `eligibility` and `certification`; groups nest inside them, `repeatable` groups (employers on record, jobs) become rows, `display` items are notices and the hairline dividers between question blocks. `binds` carry the logic by path: `relevant` shows a follow-up only when its parent answer calls for it, `required`, `readonly` for record-supplied values, and `constraint` with a `constraintMessage` for the rules the screens state — every rule is a FEL expression, `$` being the field's own value. `instances.claimant` is the agency record the questions read through `@instance('claimant')`. The employers-on-record group declares `seedFrom` so a new Response opens one row per `claimant.employersOnRecord` element, with `payerName` filled by relative `prePopulate`. `issuer` points at who is asking. `optionSets` holds the shared yes/no pair and the state list. `migrations.from[\"1.0.0\"]` says how last year's answers become this year's. `nonRelevantBehavior: remove` means a hidden follow-up's answer leaves the submission entirely.",
  "nonRelevantBehavior": "remove",
  "formPresentation": {
    "pageMode": "single",
    "labelPosition": "top",
    "density": "comfortable",
    "defaultCurrency": "USD"
  },
  "instances": {
    "claimant": {
      "description": "Agency claimant record for the certification week, supplied by the host at load time. Fetched when the form loads: here from a JSON file the site serves, in production from the agency's record system. No inline copy — if the fetch fails the record is absent and the form says so.",
      "source": "./data/claimant.json",
      "static": true,
      "readonly": true,
      "schema": {
        "benefitWeek": "object",
        "returnToWorkDate": "date",
        "employersOnRecord": "array",
        "lastDayOfWork": "date",
        "dateOfClaim": "date"
      }
    }
  },
