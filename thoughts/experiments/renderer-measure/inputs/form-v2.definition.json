  "items": [
    {
      "key": "eligibility",
      "type": "group",
      "label": "Eligibility Questions",
      "children": [
        {
          "key": "weekNotice",
          "type": "display",
          "label": "You’re claiming benefits for the week of\n\n**{{formatDate(@instance('claimant').benefitWeek.start, 'medium')}} to {{formatDate(@instance('claimant').benefitWeek.end, 'medium')}}**"
        },
        {
          "key": "honesty",
          "type": "display",
          "label": "Answer all questions honestly and completely."
        },
        {
          "key": "ableAndAvailable",
          "type": "field",
          "dataType": "choice",
          "label": "Were you able and available for work?",
          "optionSet": "yesNo",
          "hint": "If you are ready to start work but haven’t been offered a job, answer ‘Yes.’\n\nAnswer ‘No’ if something is currently preventing you from accepting a full-time job. Some examples include:\n- Physical or mental health\n- Hospitalization\n- Transportation\n- Childcare\n- Caregiving\n- Travel / Vacation\n- Schedule conflict"
        },
        {
          "key": "notAvailableReason",
          "type": "field",
          "dataType": "text",
          "label": "Explain why you were not able and available for work, and provide the dates."
        },
        {
          "key": "seekingWork",
          "type": "field",
          "dataType": "choice",
          "label": "Were you actively seeking work?",
          "optionSet": "yesNo"
        },
        {
          "key": "notSeekingReason",
          "type": "field",
          "dataType": "text",
          "label": "Explain why you were not actively seeking work."
        },
        {
          "key": "refusedWork",
          "type": "field",
          "dataType": "choice",
          "label": "Did you refuse any work?",
          "optionSet": "yesNo"
        },
        {
          "key": "refusalReason",
          "type": "field",
          "dataType": "text",
          "label": "Explain the work offer and your reason for refusal."
        },
        {
          "key": "dividerBeforeSchool",
          "type": "display",
          "label": ""
        },
        {
          "key": "inSchool",
          "type": "field",
          "dataType": "choice",
          "label": "Were you attending school or job training?",
          "optionSet": "yesNo",
          "hint": "Answer ‘Yes’ if you are in school, even if on a regularly scheduled break of four weeks or less. Answer ‘No’ if you attended a part-time class, a union training, or any self-enrichment course that does not interfere with your efforts to accept employment."
        },
        {
          "key": "progressSatisfactory",
          "type": "field",
          "dataType": "choice",
          "label": "Was your attendance and progress satisfactory?",
          "optionSet": "yesNo"
        },
        {
          "key": "progressReason",
          "type": "field",
          "dataType": "text",
          "label": "Explain why your attendance or progress was unsatisfactory."
        },
        {
          "key": "dividerBeforeHolidayPay",
          "type": "display",
          "label": ""
        },
        {
          "key": "holidayPay",
          "type": "field",
          "dataType": "choice",
          "label": "Did you receive holiday or vacation pay for this certification week?",
          "optionSet": "yesNo"
        },
        {
          "key": "holidayPayAmount",
          "type": "field",
          "dataType": "integer",
          "prefix": "$",
          "label": "Enter gross amount of holiday or vacation pay before deductions.",
          "hint": "Enter whole dollars only. Enter 9999 if over $9,999.",
          "suffix": ".00"
        },
        {
          "key": "returningToPayer",
          "type": "field",
          "dataType": "choice",
          "label": "Do you anticipate returning to work for the employer that paid you holiday or vacation pay?",
          "optionSet": "yesNo"
        },
        {
          "key": "expectedReturnDate",
          "type": "field",
          "dataType": "date",
          "label": "Expected return to work date",
          "hint": "If you are unsure of the exact date, please enter an approximate date. Use format mm/dd/yyyy"
        },
        {
          "key": "dividerBeforeRetirement",
          "type": "display",
          "label": ""
        },
        {
          "key": "retirement",
          "type": "group",
          "label": "Retirement and pension",
          "children": [
            {
              "key": "retirementNote",
              "type": "display",
              "label": "Social Security, Disability, Military Disability, Worker’s Compensation, Survivor/Widow’s Pension, or Supplemental Social Security payments are not considered retirement or pension."
            },
            {
              "key": "employersOnRecord",
              "type": "group",
              "label": "Your employers on record",
              "repeatable": true,
              "minRepeat": 0,
              "maxRepeat": 10,
              "seedFrom": {
                "instance": "claimant",
                "path": "employersOnRecord"
              },
              "children": [
                {
                  "key": "payerName",
                  "type": "field",
                  "dataType": "string",
                  "label": "Employer",
                  "prePopulate": {
                    "instance": "claimant",
                    "path": "name",
                    "editable": false
                  }
                },
                {
                  "key": "receivedRetirement",
                  "type": "field",
                  "dataType": "choice",
                  "label": "Have you received any money from a retirement account or pension from {{$payerName}}? This could be a monthly payment, a one-time payment, or money you took out from employer plans like 401(k), 403(b), or 457(b).",
                  "optionSet": "yesNo",
                  "hint": "If you are currently paying into a pension or any other retirement plan, but have not received money, answer ‘No’."
                },
                {
                  "key": "amountChanged",
                  "type": "field",
                  "dataType": "choice",
                  "label": "Have there been any changes in the amount you’re receiving from {{$payerName}}?",
                  "options": [
                    {
                      "value": "no",
                      "label": "No"
                    },
                    {
                      "value": "yes",
                      "label": "Yes"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "key": "dividerBeforeWork",
          "type": "display",
          "label": ""
        },
        {
          "key": "work",
          "type": "group",
          "label": "Work this week",
          "children": [
            {
              "key": "workedThisWeek",
              "type": "field",
              "dataType": "choice",
              "label": "Did you work between {{formatDate(@instance('claimant').benefitWeek.start, 'full')}} and {{formatDate(@instance('claimant').benefitWeek.end, 'full')}} for any employer, including part time and per diem, self-employment, and gig work?",
              "optionSet": "yesNo"
            },
            {
              "key": "returnToWork",
              "type": "group",
              "label": "Return to work on record",
              "children": [
                {
                  "key": "rtwCorrect",
                  "type": "field",
                  "dataType": "choice",
                  "label": "Our records indicate you have a Return to Work date of {{formatDate(@instance('claimant').returnToWorkDate, 'medium')}}. Is this correct?",
                  "optionSet": "yesNo"
                },
                {
                  "key": "returnedAtAll",
                  "type": "field",
                  "dataType": "choice",
                  "label": "Did you return to work at all?",
                  "optionSet": "yesNo"
                },
                {
                  "key": "correctedRtwDate",
                  "type": "field",
                  "dataType": "date",
                  "label": "Enter correct Return to Work date",
                  "hint": "Use format mm/dd/yyyy"
                },
                {
                  "key": "rtwWorkDetails",
                  "type": "group",
                  "label": "Hours and earnings",
                  "children": [
                    {
                      "key": "rtwHoursWorked",
                      "type": "group",
                      "label": "Enter the total number of hours and minutes you worked.",
                      "presentation": {
                        "layout": {
                          "flow": "grid",
                          "columns": 12
                        }
                      },
                      "children": [
                        {
                          "key": "rtwHours",
                          "type": "field",
                          "dataType": "integer",
                          "label": "Hours",
                          "presentation": {
                            "layout": {
                              "grid": {
                                "span": 6
                              }
                            }
                          }
                        },
                        {
                          "key": "rtwMinutes",
                          "type": "field",
                          "dataType": "integer",
                          "label": "Minutes",
                          "presentation": {
                            "layout": {
                              "grid": {
                                "span": 6
                              }
                            }
                          }
                        }
                      ],
                      "hint": "If you have worked more than 99 hours, enter ‘99’."
                    },
                    {
                      "key": "rtwGrossEarnings",
                      "type": "field",
                      "dataType": "integer",
                      "prefix": "$",
                      "label": "Enter the gross amount earned (or you expect to be paid) from this employer. This is the total amount earned (not the hourly rate of pay) **before any deductions** are taken out and **includes tips.**",
                      "hint": "Enter whole dollars only. Enter 9999 if over $9,999.",
                      "suffix": ".00"
                    }
                  ]
                }
              ]
            },
            {
              "key": "lastDayOfWorkCheck",
              "type": "group",
              "label": "Last day of work on record",
              "children": [
                {
                  "key": "ldwCorrect",
                  "type": "field",
                  "dataType": "choice",
                  "optionSet": "yesNo",
                  "label": "Our records indicate your Last day of Work was {{formatDate(@instance('claimant').lastDayOfWork, 'medium')}}. Is this correct?"
                },
                {
                  "key": "correctedLdwDate",
                  "type": "field",
                  "dataType": "date",
                  "label": "Enter correct Last day of Work date",
                  "hint": "Use format mm/dd/yyyy"
                },
                {
                  "key": "ldwWorkDetails",
                  "type": "group",
                  "label": "Hours and earnings",
                  "children": [
                    {
                      "key": "ldwHoursWorked",
                      "type": "group",
                      "label": "Enter the total number of hours and minutes you worked.",
                      "hint": "If you have worked more than 99 hours, enter ‘99’.",
                      "presentation": {
                        "layout": {
                          "flow": "grid",
                          "columns": 12
                        }
                      },
                      "children": [
                        {
                          "key": "ldwHours",
                          "type": "field",
                          "dataType": "integer",
                          "label": "Hours",
                          "presentation": {
                            "layout": {
                              "grid": {
                                "span": 6
                              }
                            }
                          }
                        },
                        {
                          "key": "ldwMinutes",
                          "type": "field",
                          "dataType": "integer",
                          "label": "Minutes",
                          "presentation": {
                            "layout": {
                              "grid": {
                                "span": 6
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "key": "ldwGrossEarnings",
                      "type": "field",
                      "dataType": "integer",
                      "prefix": "$",
                      "suffix": ".00",
                      "label": "Enter the gross amount earned (or you expect to be paid) from this employer. This is the total amount earned (not the hourly rate of pay) **before any deductions** are taken out and **includes tips.**",
                      "hint": "Enter whole dollars only. Enter 9999 if over $9,999."
                    }
                  ]
                }
              ]
            },
            {
              "key": "jobLimit",
              "type": "display",
              "label": "You can enter up to 4 employers."
            },
            {
              "key": "jobLimitMore",
              "type": "display",
              "label": "You can enter up to 4 more employers."
            },
            {
              "key": "jobs",
              "type": "group",
              "label": "Job",
              "repeatable": true,
              "minRepeat": 1,
              "maxRepeat": 4,
              "children": [
                {
                  "key": "employerName",
                  "type": "field",
                  "dataType": "string",
                  "label": "Employer’s name"
                },
                {
                  "key": "street",
                  "type": "field",
                  "dataType": "string",
                  "label": "Employer’s street address"
                },
                {
                  "key": "city",
                  "type": "field",
                  "dataType": "string",
                  "label": "City",
                  "presentation": {
                    "layout": {
                      "grid": {
                        "span": 6
                      }
                    }
                  }
                },
                {
                  "key": "state",
                  "type": "field",
                  "dataType": "choice",
                  "label": "State",
                  "optionSet": "usStates",
                  "presentation": {
                    "layout": {
                      "grid": {
                        "span": 6
                      }
                    }
                  }
                },
                {
                  "key": "zip",
                  "type": "field",
                  "dataType": "string",
                  "label": "ZIP code",
                  "presentation": {
                    "layout": {
                      "grid": {
                        "span": 12
                      }
                    }
                  }
                },
                {
                  "key": "phone",
                  "type": "field",
                  "dataType": "string",
                  "label": "Phone number (optional)"
                },
                {
                  "key": "hoursWorked",
                  "type": "group",
                  "label": "Enter the total number of hours and minutes you worked.",
                  "presentation": {
                    "layout": {
                      "flow": "grid",
                      "columns": 12
                    }
                  },
                  "children": [
                    {
                      "key": "hours",
                      "type": "field",
                      "dataType": "integer",
                      "label": "Hours",
                      "presentation": {
                        "layout": {
                          "grid": {
                            "span": 6
                          }
                        }
                      }
                    },
                    {
                      "key": "minutes",
                      "type": "field",
                      "dataType": "integer",
                      "label": "Minutes",
                      "presentation": {
                        "layout": {
                          "grid": {
                            "span": 6
                          }
                        }
                      }
                    }
                  ],
                  "hint": "If you have worked more than 99 hours, enter ‘99’."
                },
                {
                  "key": "grossEarnings",
                  "type": "field",
                  "dataType": "integer",
                  "prefix": "$",
                  "label": "Enter the gross amount earned (or you expect to be paid) from this employer. This is the total amount earned (not the hourly rate of pay) **before any deductions** are taken out and **includes tips.**",
                  "hint": "Enter whole dollars only. Enter 9999 if over $9,999.",
                  "suffix": ".00"
                },
                {
                  "key": "workedAllHours",
                  "type": "field",
                  "dataType": "choice",
                  "label": "Did you work all hours offered?",
                  "optionSet": "yesNo"
                },
                {
                  "key": "whyNotAllHours",
                  "type": "field",
                  "dataType": "text",
                  "label": "Why didn’t you work all hours offered?"
                },
                {
                  "key": "workType",
                  "type": "field",
                  "dataType": "choice",
                  "label": "What type of work was this job?",
                  "options": [
                    {
                      "value": "regular",
                      "label": "Regular employment"
                    },
                    {
                      "value": "self",
                      "label": "Self-employment"
                    },
                    {
                      "value": "gig",
                      "label": "Gig work"
                    }
                  ]
                }
              ],
              "presentation": {
                "layout": {
                  "flow": "grid",
                  "columns": 12
                }
              }
            }
          ]
        }
      ]
    },
    {
      "key": "dividerBeforeCertification",
      "type": "display",
      "label": ""
    },
    {
      "key": "certification",
      "type": "group",
      "label": "Certification",
      "children": [
        {
          "key": "certified",
          "type": "field",
          "dataType": "boolean",
          "label": "I certify that all questions have been answered truthfully. I understand that [false and misleading information](https://www.law.cornell.edu/uscode/text/18/1001) may result in loss of benefits. In addition, I may be subject to fines and penalties if benefits are improperly paid to me as a result of providing false information."
        }
      ]
    }
  ],
  "binds": [
    {
      "path": "eligibility.ableAndAvailable",
      "required": "true"
    },
    {
      "path": "eligibility.seekingWork",
      "required": "true"
    },
    {
      "path": "eligibility.refusedWork",
      "required": "true"
    },
    {
      "path": "eligibility.inSchool",
      "required": "true"
    },
    {
      "path": "eligibility.holidayPay",
      "required": "true"
    },
    {
      "path": "eligibility.notAvailableReason",
      "relevant": "$eligibility.ableAndAvailable = 'no'",
      "required": "true",
      "constraint": "length($) <= 200",
      "constraintMessage": "Use 200 characters or fewer."
    },
    {
      "path": "eligibility.notSeekingReason",
      "relevant": "$eligibility.seekingWork = 'no'",
      "required": "true",
      "constraint": "length($) <= 200",
      "constraintMessage": "Use 200 characters or fewer."
    },
    {
      "path": "eligibility.refusalReason",
      "relevant": "$eligibility.refusedWork = 'yes'",
      "required": "true",
      "constraint": "length($) <= 200",
      "constraintMessage": "Use 200 characters or fewer."
    },
    {
      "path": "eligibility.progressReason",
      "relevant": "$eligibility.inSchool = 'yes' and $eligibility.progressSatisfactory = 'no'",
      "required": "true",
      "constraint": "length($) <= 200",
      "constraintMessage": "Use 200 characters or fewer."
    },
    {
      "path": "eligibility.progressSatisfactory",
      "relevant": "$eligibility.inSchool = 'yes'",
      "required": "true"
    },
    {
      "path": "eligibility.holidayPayAmount",
      "relevant": "$eligibility.holidayPay = 'yes'",
      "required": "true",
      "constraint": "$ >= 0 and $ <= 9999",
      "constraintMessage": "Enter whole dollars from 0 to 9999."
    },
    {
      "path": "eligibility.returningToPayer",
      "relevant": "$eligibility.holidayPay = 'yes'",
      "required": "true"
    },
    {
      "path": "eligibility.expectedReturnDate",
      "relevant": "$eligibility.holidayPay = 'yes' and $eligibility.returningToPayer = 'yes'",
      "required": "true"
    },
    {
      "path": "eligibility.retirement.employersOnRecord[*].payerName",
      "readonly": "true"
    },
    {
      "path": "eligibility.retirement.employersOnRecord[*].receivedRetirement",
      "required": "true"
    },
    {
      "path": "eligibility.retirement.employersOnRecord[*].amountChanged",
      "relevant": "$receivedRetirement = 'yes'",
      "required": "true"
    },
