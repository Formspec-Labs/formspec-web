{
  "name": "@formspec-org/surface-react",
  "description": "React binding for the Surface shell — renders route plans, slots, and the starter module-widget set",
  "version": "2.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-org/formspec.git",
    "directory": "packages/formspec-surface-react"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "default": "./dist/widgets/index.js"
    },
    "./widget-metadata": {
      "types": "./dist/widget-metadata.d.ts",
      "default": "./dist/widget-metadata.js"
    },
    "./formspec-surface.css": "./dist/formspec-surface.css"
  },
  "peerDependencies": {
    "@formspec-org/app-graph": "^2.0.2",
    "@formspec-org/engine": "^2.0.2",
    "@formspec-org/layout": "^2.0.2",
    "@formspec-org/react": "^2.0.2",
    "@formspec-org/surface": "^2.0.2",
    "@formspec-org/types": "^0.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "canonicalize": "^3.0.0"
  }
}
