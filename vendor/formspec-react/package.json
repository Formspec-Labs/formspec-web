{
  "name": "@formspec-org/react",
  "version": "2.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./semantic-controls": {
      "import": {
        "types": "./dist/semantic-controls.d.ts",
        "default": "./dist/semantic-controls.js"
      },
      "require": {
        "types": "./dist/semantic-controls.d.cts",
        "default": "./dist/semantic-controls.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@formspec-org/engine": "^2.0.2",
    "@formspec-org/layout": "^2.0.2",
    "@formspec-org/types": "^0.2.0",
    "@preact/signals-core": "^1.8.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "marked": "^15.0.7",
    "sanitize-html": "^2.14.0"
  },
  "description": "React hooks and auto-renderer for Formspec — use any component library with FormEngine",
  "sideEffects": false
}
