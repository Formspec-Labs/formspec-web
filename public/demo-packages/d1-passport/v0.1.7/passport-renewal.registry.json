    {
      "name": "x-signing-ceremony",
      "category": "widget",
      "version": "0.1.0",
      "status": "stable",
      "description": "Shared read, consent, Sign, then Submit widget.",
      "compatibility": {
        "formspecVersion": ">=1.0.0 <2.0.0"
      },
      "widgetShape": {
        "widgetName": "SigningCeremony",
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentRefs",
            "copy"
          ],
          "properties": {
            "requireResponseReview": {
              "type": "boolean"
            },
            "contentRefs": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "version"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "format": "uri"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "Exact authored content entry URI and content version. The URI is the pinned Definition URL followed by #/extensions/x-formspec-signing-content/entries/<simple identifier>."
              }
            },
            "copy": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "heading",
                  "readInstruction",
                  "readConfirmation",
                  "signerName",
                  "pending",
                  "signed",
                  "failed",
                  "unavailable"
                ],
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "readInstruction": {
                    "type": "string",
                    "minLength": 1
                  },
                  "readConfirmation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "signerName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pending": {
                    "type": "string",
                    "minLength": 1
                  },
                  "signed": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failed": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unavailable": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewPending": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewUnavailable": {
                    "type": "string",
                    "minLength": 1
                  },
                  "x-generation": {
                    "type": "object"
                  }
                }
              }
            },
            "x-generation": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "requireResponseReview"
                ],
                "properties": {
                  "requireResponseReview": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "copy": {
                    "additionalProperties": {
                      "required": [
                        "reviewPending",
                        "reviewUnavailable"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "dataInputs": [
          {
            "name": "content",
            "required": true
          },
          {
            "name": "response",
            "required": true
          },
          {
            "name": "draft",
            "required": true
          },
          {
            "name": "actor",
            "required": true
          },
          {
            "name": "signingResult",
            "required": true
          },
          {
            "name": "actionLabels",
            "required": true
          },
          {
            "name": "review",
            "required": false
          }
        ],
        "actionOutputs": [
          {
            "name": "sign"
          },
          {
            "name": "submit"
          },
          {
            "name": "paper"
          }
        ],
        "childrenPolicy": "none",
        "deliveryContractId": "@formspec-org/surface-react/SigningCeremony@0.1",
        "renderedConfigNodes": [
          {
            "pointerPattern": "",
            "kind": "signing-ceremony"
          },
          {
            "pointerPattern": "/copy/*",
            "kind": "signing-ceremony-copy"
          }
        ]
      }
    },
