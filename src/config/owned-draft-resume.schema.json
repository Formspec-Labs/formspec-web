{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draftId"
  ],
  "properties": {
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "expectedResponseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "initializationOnly": {
      "const": true
    }
  },
  "oneOf": [
    {
      "properties": {
        "expectedResponseId": true
      },
      "required": [
        "expectedResponseId"
      ]
    },
    {
      "properties": {
        "initializationOnly": true
      },
      "required": [
        "initializationOnly"
      ]
    }
  ]
}
