{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:formspec:server:native-current-check-selector:1",
  "title": "Explicit immutable native run selector for a current signed-candidate check",
  "type": "object",
  "properties": {
    "selectionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "runRevision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "selectionHash",
    "runId",
    "runRevision"
  ],
  "additionalProperties": false
}
